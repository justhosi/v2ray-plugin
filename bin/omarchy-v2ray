#!/bin/bash
# =============================================================================
# omarchy-v2ray — backend CLI for the Omarchy "v2ray Client" bar plugin.
# =============================================================================
#
# WHY THIS FILE EXISTS
# --------------------
# A Quickshell bar plugin runs inside the long-lived `omarchy-shell` process, as
# the desktop user, with no TTY and no way to type a password. That makes it a
# terrible place to keep process-management logic:
#
#   * every command must be non-interactive,
#   * a crash inside QML takes the whole bar down with it,
#   * you cannot test QML from a terminal.
#
# So the plugin's QML stays thin (draw an icon, show a list) and *all* of the
# risky work — parsing, writing files, starting/stopping the engine, measuring
# latency — lives here, where you can run it by hand and read the output.
#
# This script prints JSON on stdout for every subcommand, so the QML side can
# `JSON.parse()` the result without guessing at formats.
#
# NOTHING IN HERE NEEDS ROOT. The engine runs as a plain user process listening
# on 127.0.0.1. See README.md for the TUN-mode caveat.
#
# LAYOUT ON DISK
# --------------
#   ~/.config/omarchy-v2ray/
#   ├── profiles/
#   │   ├── <id>.meta.json     # display name, type, host, ports, original link
#   │   └── <id>.config.json   # the real xray/v2ray config (mode 0600!)
#   └── state/
#       ├── engine.pid         # PID of the running engine
#       ├── engine.log         # engine stdout+stderr
#       ├── active.id          # profile id currently connected
#       ├── started.epoch      # unix time the tunnel came up
#       └── autostart.id       # profile to auto-connect on shell start
#
# The two files are split on purpose: the config holds the secret UUID, the
# meta file holds everything safe to show in the UI (and to copy/paste).
#
# TUN mode is a *system-wide* tunnel: it needs a tun device, which needs
# CAP_NET_ADMIN, so the helper that creates it is privileged. Its state therefore
# lives outside this tree, in a file that helper writes and this script only ever
# READS (nothing here gains privileges):
#
#   /run/omarchy-v2ray-tun/state.json
#       {"profileId":"...","iface":"...","pid":"1234","since":1700000000}
#
# The helper writes it atomically; we treat every field as untrusted text and
# degrade to "not active" on anything we cannot read (see read_tun_state). The
# path is overridable with OMARCHY_V2RAY_TUN_STATE, so tests can point it at a
# temp dir without touching /run — the same reason OMARCHY_V2RAY_HOME exists.
#
# The helper also records WHY the last start failed in
#
#   /run/omarchy-v2ray-tun/last-error
#
# a one-line, already-flattened explanation (engine log tail, or the refusal
# itself). `status` surfaces it as tunLastError so the panel can say "the engine
# died" or "that profile is gone" instead of only that TUN is not up. It can
# never explain a cancelled polkit prompt: when the helper does not run, nobody
# is there to write the file — that belongs to the polkit slice.
#
# The helper that pkexec executes is installed OUTSIDE the plugin tree, at
# /usr/local/lib/omarchy-v2ray/omarchy-v2ray-tun (root-owned, 0755), by
# `install-tun`. The plugin tree is user-writable, so executing a helper from
# there would make the "privileged half" replaceable by any process running as
# the desktop user. Both sides check ownership before anything privileged.
#
# SUBCOMMANDS
# -----------
#   status              Engine/profile/connection state as one JSON object.
#   tun-status          Read-only TUN state: can it start here, is it active.
#   tun-up <id>         Start the system-wide TUN tunnel through pkexec.
#                       Returns at once; the polkit prompt must not block the
#                       panel (see cmd_tun_up).
#   tun-down            Stop it (also through pkexec; idempotent).
#   tun-toggle <id>     Down when active, otherwise up.
#   list                Every imported profile as a JSON array.
#   import              Read {id,meta,config} JSON on STDIN, write a profile.
#                       (stdin only, on purpose: an argv or environment payload
#                       would expose the UUID — see cmd_import.)
#   remove <id>         Delete a profile (and disconnect it if it was active).
#   start <id>          Launch the engine against a profile.
#   stop                Stop the engine.
#   toggle              Stop if running, otherwise start the autostart profile.
#   restart <id>        Convenience: stop then start.
#   ping <id>           Real latency through a temporary engine on a spare port.
#   link <id>           Print the original share link.
#   log [lines]         Tail the engine log (default 30 lines).
#   autostart [<id>|off] Get or set the profile that auto-connects.
#   install-engine      Open a floating terminal that installs v2ray.
#   install-xray        Open a floating terminal that installs xray from the AUR.
#   install-tun         Install the privileged TUN helper to
#                       /usr/local/lib/omarchy-v2ray through pkexec, in a
#                       visible terminal. The helper must NEVER be executed from
#                       the plugin tree (which the user owns) — see
#                       cmd_install_tun.
#   debug <id>          Verbose one-shot diagnosis: run the engine at debug
#                       level, make one request, print the engine's own log.
#   reveal              Open the config directory in the file manager.
#   version             Print this script's version.
#
# EXIT CODES
# ----------
#   0  success            (stdout is valid JSON)
#   1  expected failure   (stdout is {"ok":false,"error":"..."} — never stderr,
#                          so the QML caller can always parse one place)
#
# =============================================================================

# `-u` catches typos in variable names; `pipefail` makes a failing command
# inside a pipeline fail the whole pipeline. We deliberately do NOT use `-e`,
# because many subcommands must inspect a non-zero exit code and keep going.
set -uo pipefail

VERSION="0.1.0"

# -----------------------------------------------------------------------------
# Paths. Everything overridable via environment so tests can use a temp dir
# without touching the user's real profiles.
# -----------------------------------------------------------------------------
CONFIG_DIR="${OMARCHY_V2RAY_HOME:-$HOME/.config/omarchy-v2ray}"
PROFILES_DIR="$CONFIG_DIR/profiles"
STATE_DIR="$CONFIG_DIR/state"
PID_FILE="$STATE_DIR/engine.pid"
LOG_FILE="$STATE_DIR/engine.log"
ACTIVE_FILE="$STATE_DIR/active.id"
STARTED_FILE="$STATE_DIR/started.epoch"
AUTOSTART_FILE="$STATE_DIR/autostart.id"
# The TUN state file is NOT under CONFIG_DIR: a root helper writes it (see the
# LAYOUT ON DISK note), and it must be readable without touching the user tree.
TUN_STATE_FILE="${OMARCHY_V2RAY_TUN_STATE:-/run/omarchy-v2ray-tun/state.json}"
# The helper's directory, derived from the state path when only that one override
# is given: both files live together, and a test that points at a temp dir must
# not silently read /run for the error text.
TUN_RUN_DIR="${OMARCHY_V2RAY_TUN_RUN_DIR:-${TUN_STATE_FILE%/*}}"
TUN_LAST_ERROR_FILE="$TUN_RUN_DIR/last-error"

# Default local proxy ports. The panel can override these per import through the
# widget settings; these are only the fallback.
DEFAULT_SOCKS_PORT="${OMARCHY_V2RAY_SOCKS_PORT:-10808}"
DEFAULT_HTTP_PORT="${OMARCHY_V2RAY_HTTP_PORT:-10809}"

# Host used for the latency probe. A 204-responder is ideal: tiny body, never
# cached by proxies, and reachable from essentially anywhere.
PING_URL="${OMARCHY_V2RAY_PING_URL:-https://www.gstatic.com/generate_204}"
# The host whose HTTP Date header the debug command uses to measure clock
# drift. Any well-connected TLS host does; this one is just reliably up.
PING_HOST_FOR_CLOCK="${OMARCHY_V2RAY_CLOCK_URL:-www.cloudflare.com}"
PING_TIMEOUT="${OMARCHY_V2RAY_PING_TIMEOUT:-8}"
# The debug command gives the dial more room than the ping does: a slow or
# filtered route should be *reported*, not cut off before it can fail.
DEBUG_TIMEOUT="${OMARCHY_V2RAY_DEBUG_TIMEOUT:-12}"

# Bounds for reading an import payload off stdin. A real xray config is ~1 KB;
# these ceilings exist so a caller that opens the pipe and never closes it can
# neither hang this process forever nor make it allocate without bound.
#
# Both ceilings are *refusals*, not silent truncations. A reader capped at
# exactly the ceiling cannot tell a complete payload of that size from a larger
# one it has just cut off, and a cut landing just past a valid JSON document
# would be stored with its tail quietly dropped. The reader therefore asks for
# one byte MORE than the ceiling and refuses whatever produced it (see
# cmd_import); a read that reaches the wall clock without EOF is refused too.
IMPORT_MAX_BYTES="${OMARCHY_V2RAY_IMPORT_MAX_BYTES:-262144}"
IMPORT_READ_TIMEOUT="${OMARCHY_V2RAY_IMPORT_TIMEOUT:-15}"

# -----------------------------------------------------------------------------
# Output helpers.
#
# Every failure path goes through emit_error so the contract "stdout is always
# parseable JSON" holds even for silly mistakes like a missing argument.
# -----------------------------------------------------------------------------
emit_error() {
  # $1 = human-readable message
  jq -n --arg error "$1" '{ok: false, error: $error}'
  exit 1
}

emit_ok() {
  # $1 = optional JSON object built by the caller (already a string)
  if [[ -n ${1:-} ]]; then printf '%s\n' "$1"; else echo '{"ok": true}'; fi
  exit 0
}

ensure_dirs() {
  # The umask comes FIRST, before anything is created. It is what makes every
  # directory of this tree 0700 and every file in it 0600, and the tree holds
  # the credential itself (the UUID or password inside <id>.config.json), so it
  # has to be private from the very first byte.
  #
  # This is a fix, not a tidy-up: the umask used to be set *after* the mkdir, so
  # a first-ever run created CONFIG_DIR, profiles/ and state/ with whatever umask
  # the user had (022 on a stock shell) — 0755, world-listable. The files inside
  # were still 0600, so no UUID was ever readable, but `ls` on the profiles
  # directory published the profile ids (`<name>-<hash>`, i.e. which servers the
  # user has) to every local user. A validation pass on a cold start caught it.
  umask 077

  mkdir -p "$PROFILES_DIR" "$STATE_DIR"

  # Repair a tree an older version already created: mkdir -p never changes the
  # mode of a directory that exists, so an install left at 0755 would stay
  # listable for the life of the machine. These three directories are ours to
  # own, so set them explicitly on every call (idempotent, and cheap next to the
  # jq work that follows). Failures are ignored on purpose — an
  # OMARCHY_V2RAY_HOME the user pointed at a path they cannot chmod is not a
  # reason to refuse an import.
  chmod 700 "$CONFIG_DIR" "$PROFILES_DIR" "$STATE_DIR" 2>/dev/null || true
}

# -----------------------------------------------------------------------------
# Small utilities.
# -----------------------------------------------------------------------------

# engine_bin — echo the name of an installed v2ray-family core, or nothing.
#
# Preference order and WHY:
#
#   1. xray   — actively-developed core; its config schema is a superset of
#               v2ray-core's for everything we generate, and it is the only one
#               of the two that understands REALITY, XHTTP and the Vision flow
#               control. NOT in Arch's official repos: it lives in the AUR
#               (install with `yay -S xray` or `omarchy pkg aur add xray`).
#               We only *prefer* it when the user already has it.
#
#   2. v2ray  — Arch's official `extra/v2ray` package. This is what
#               `install-engine` below installs, because the official repos are
#               always reachable and need no AUR helper. It speaks VLESS/Trojan/
#               Shadowsocks and (on plain TLS) everything the basic link types
#               need — just not REALITY/XHTTP.
engine_bin() {
  if command -v xray >/dev/null 2>&1; then
    echo "xray"
  elif command -v v2ray >/dev/null 2>&1; then
    echo "v2ray"
  fi
}

# -----------------------------------------------------------------------------
# xray_only_features ID — name the link features this profile needs that
# v2ray-core cannot do, or print nothing when v2ray can handle the profile.
# -----------------------------------------------------------------------------
# WHY THIS EXISTS (the failure it prevents is genuinely confusing):
#
#   v2ray-core does NOT implement REALITY or XHTTP. It does not reject them
#   either — `streamSettings.security` is only a string to its config parser, so
#   a config with security:"reality" is accepted as "Configuration OK" and then
#   the engine simply dials the server in the clear. The REALITY server never
#   answers, the SOCKS port stays silent, and every layer above reports the only
#   thing it can see: "the tunnel did not answer (bad UUID, wrong server, or
#   blocked port)" — for a link that works fine in the user's phone client.
#
#   So we refuse *before* starting, and we name the actual fix.
xray_only_features() {
  local meta
  meta="$(meta_path "$1")"
  [[ -f $meta ]] || return 0

  local features="" security network
  security="$(jq -r '.security // ""' "$meta" 2>/dev/null)"
  network="$(jq -r '.network // ""' "$meta" 2>/dev/null)"

  [[ $security == "reality" ]] && features="REALITY"
  # v2ray-core has no xhttp/splithttp transport; xray added both.
  if [[ $network == "xhttp" || $network == "splithttp" ]]; then
    features="${features:+$features + }XHTTP"
  fi

  printf '%s' "$features"
}

# -----------------------------------------------------------------------------
# require_capable_engine ID ENGINE — refuse early when the installed core is the
# wrong one. Prints the JSON error and returns 1 when the profile cannot work,
# returns 0 when we may proceed.
# -----------------------------------------------------------------------------
require_capable_engine() {
  local id="$1" engine="$2"
  # xray is a superset: it runs everything we generate, so nothing to check.
  [[ $engine == "xray" ]] && return 0

  local missing
  missing="$(xray_only_features "$id")"
  [[ -z $missing ]] && return 0

  jq -n --arg e "This server needs $missing, which only the xray core supports — v2ray cannot do it. Install xray with: omarchy pkg aur add xray" \
        '{ok:false, error:$e, needsXray:true}'
  return 1
}

# -----------------------------------------------------------------------------
# tun_engine_reason ENGINE — the user-facing fix when the installed core cannot
# do TUN mode, or nothing at all when it can.
# -----------------------------------------------------------------------------
# WHY THIS IS A HARD REQUIREMENT: v2ray-core has no `tun` inbound. Its config
# parser does not reject the key — it simply has nowhere to put it — so a TUN
# config fed to v2ray starts an ordinary local proxy and the system-wide tunnel
# silently never exists. xray implements the inbound natively (verified against
# xray 26.3.27), so the only honest answer on v2ray is the package to install.
tun_engine_reason() {
  local engine="${1:-}"
  [[ $engine == "xray" ]] && return 0
  if [[ -z $engine ]]; then
    printf '%s' "TUN needs the xray core, and no engine is installed: omarchy pkg aur add xray"
  else
    printf '%s' "TUN needs the xray core (v2ray has no tun inbound): omarchy pkg aur add xray"
  fi
}

# -----------------------------------------------------------------------------
# probe_cert HOST PORT SNI — "subject=... issuer=..." for the certificate a TLS
# server presents for that SNI, or an empty string if openssl is missing / the
# connection failed.
# -----------------------------------------------------------------------------
# WHY: REALITY clients log "received real certificate (potential MITM or
# redirection)" whenever the handshake is not authenticated. That single message
# covers four very different situations, and this probe separates them:
#
#   * we reached the real server and it declined our REALITY auth, or
#   * something on the network path answered instead of the server.
#
# Comparing the certificate a server IP shows against the one the *real* domain
# shows is the cheapest way to tell those apart.
probe_cert() {
  command -v openssl >/dev/null 2>&1 || return 0
  local host="$1" port="$2" sni="$3"
  [[ -n $host && -n $port && -n $sni ]] || return 0
  local out
  out="$(timeout 12 openssl s_client -connect "$host:$port" -servername "$sni" -alpn http/1.1 \
        </dev/null 2>/dev/null \
        | openssl x509 -noout -subject -issuer 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g;s/ *$//')"
  printf '%s' "$out"
}

# -----------------------------------------------------------------------------
# ca_of "subject=CN=www.google.com issuer=C=US, O=Google Trust Services, CN=WE2"
#       -> "Google Trust Services"
# -----------------------------------------------------------------------------
# WHY: the "the server is declining us" vs "someone is intercepting us" diagnosis
# works by comparing the certificate a server IP shows with the one the genuine
# domain shows. Neither the SUBJECT nor the ISSUER can be compared verbatim:
#
#   * the subject is identical anyway (CN=www.google.com), so it proves nothing;
#   * the issuer is legitimately different between datacenters — Google signs with
#     several certificate authorities and the "CN=" of the issuer names the FRONT
#     that served you (GTS WE2, GTS WR2, ...), which changes as you roam between
#     networks and even between requests.
#
# Comparing the full string therefore produced a false "MISMATCH — someone is
# intercepting you!" on connections that were in fact perfectly healthy. What DOES
# identify the signer is the issuer ORGANISATION ("O=Google Trust Services"), so
# that is what this returns. When a certificate has no organisation field we fall
# back to the raw issuer text, which is still better than nothing.
ca_of() {
  local raw
  raw="$(printf '%s' "$1" | sed -n 's/.*issuer=//p')"
  [[ -n $raw ]] || return 0
  local org
  org="$(printf '%s' "$raw" | sed -n 's/.*O=\([^,]*\).*/\1/p')"
  if [[ -n $org ]]; then printf '%s' "$org"; else printf '%s' "$raw"; fi
}

# -----------------------------------------------------------------------------
# clock_skew_seconds — local time minus the time reported by a TLS server we
# reach directly. Empty when unavailable.
# -----------------------------------------------------------------------------
# WHY: REALITY authenticates each client with an embedded timestamp. A server
# configured with a non-zero maxTimeDiff silently rejects clients whose clock is
# too far off, and the client only ever sees "received real certificate". A few
# minutes of drift is therefore enough to break REALITY while every other
# protocol keeps working.
clock_skew_seconds() {
  local domain="${1:-www.google.com}"
  local local_epoch remote_header remote_epoch
  local_epoch="$(date +%s)"
  remote_header="$(curl -sI --max-time 8 "https://$domain" 2>/dev/null \
    | grep -i '^date:' | head -1 | cut -d' ' -f2-)"
  [[ -n $remote_header ]] || return 0
  remote_epoch="$(date -u -d "$remote_header" +%s 2>/dev/null)"
  [[ -n $remote_epoch ]] || return 0
  printf '%s' "$((local_epoch - remote_epoch))"
}

# port_listening PORT — true when something is listening on a local TCP port.
# Uses `ss` (always present with iproute2) rather than /dev/tcp, because this
# script may run under `dash`-like shells in the future and ss is cheaper.
port_listening() {
  ss -Hltn "sport = :$1" 2>/dev/null | grep -q .
}

# process_alive PID — true when the PID exists and is signalable.
process_alive() {
  [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null
}

# read_pid — echo the recorded engine PID, cleaning up a stale file.
read_pid() {
  local pid=""
  [[ -f $PID_FILE ]] && pid="$(tr -dc '0-9' <"$PID_FILE")"
  if process_alive "$pid"; then
    echo "$pid"
  else
    rm -f "$PID_FILE"
    echo ""
  fi
}

# -----------------------------------------------------------------------------
# tun_pid_alive PID — true when /proc/PID exists.
# -----------------------------------------------------------------------------
# NOT `kill -0`. Bash collapses EPERM and ESRCH into exit 1, so an unprivileged
# caller cannot distinguish "no such process" from "exists but owned by someone
# else". The privileged slice execs the engine as the INVOKING user with only
# CAP_NET_ADMIN, so /proc/<pid> will exist and remain readable to that user; the
# TUN state's liveness probe must therefore test existence there and must not
# rely on signalability.
tun_pid_alive() {
  [[ -n ${1:-} && -d /proc/$1 ]]
}

# -----------------------------------------------------------------------------
# read_tun_state — one compact JSON object describing the TUN tunnel, always
# parseable and never an error.
# -----------------------------------------------------------------------------
# The file is written by the root helper of a later slice (creating a tun device
# needs CAP_NET_ADMIN) and is only ever read here. Every field in it is untrusted
# text: the file lives in /run, it may be half-written at the instant we sample
# it, and it outlives the process it names.
#
# Therefore this function has exactly ONE failure mode, "not active". A missing
# file, an unreadable file, malformed JSON, a field of the wrong type, a partial
# write and a pid that no longer exists all return the same empty object with
# active:false. Nothing here exits, prints a diagnostic, or lets jq's stderr
# reach the caller — a `status` call must not turn into a wall of parse errors
# because a stale state file happens to exist.
#
# "Not active" is one SHAPE, not merely a flag: whenever active is false,
# profileId, iface, pid and since are all emptied/zeroed too. That single rule
# lives here so `status` and `tun-status` cannot disagree, and so a stale profile
# name or interface is never painted next to active:false.
#
# active also requires profileId and iface, not just a live pid: a file carrying
# only a pid is a partial write, and reporting it as connected would paint a
# tunnel the UI can neither name nor stop. `since` is allowed to be absent (0),
# because a running tunnel whose start time is unknown is still running.
#
# The file must hold exactly ONE JSON document. `jq -c` prints one line per
# input document, so a file with two concatenated objects (an append-style
# writer, a doubled write, JSONL) used to yield a multi-line value; callers then
# failed `jq --argjson` on it, printing nothing at all to stdout while still
# exiting 0. `jq -s` plus the `length != 1` test folds zero, one and many
# documents into the one failure mode above.
read_tun_state() {
  local off='{"active":false,"profileId":"","iface":"","since":0,"pid":""}'
  [[ -f $TUN_STATE_FILE ]] || { printf '%s' "$off"; return 0; }

  local parsed
  parsed="$(jq -sc '
    if length != 1 then empty
    elif (.[0] | type) != "object" then empty
    else .[0] |
      {
        profileId: ((.profileId // "") | if type == "string" then . else "" end),
        iface: ((.iface // "") | if type == "string" then . else "" end),
        pid: ((.pid // "") | if type == "number" then tostring
                          elif type == "string" then .
                          else "" end),
        since: ((.since // 0) | if type == "number"
                               then (floor | if . < 0 then 0 else . end)
                               else 0 end)
      }
    end
  ' "$TUN_STATE_FILE" 2>/dev/null)" || parsed=""

  # jq -c emits at most one line per output document and the filter above emits
  # at most one document, so this is defence in depth: a newline here would
  # break the --argjson callers, so drop the value rather than let it through.
  [[ $parsed != *$'\n'* ]] || parsed=""

  # A file that is not exactly one JSON object (or a value just dropped above)
  # produces nothing usable, so "unusable" and "absent" deliberately share one
  # return value.
  [[ -n $parsed ]] || { printf '%s' "$off"; return 0; }

  local pid profile="" iface=""
  pid="$(jq -r '.pid' <<<"$parsed")"
  # Only a plain decimal pid >= 1 can name a process. 0 is rejected explicitly:
  # `kill -0 0` checks the caller's own process group and would report a tunnel
  # that never existed. Anything else — empty, "12a", two pids joined by a
  # newline — is dropped rather than handed to kill.
  [[ $pid =~ ^[1-9][0-9]*$ ]] || pid=""

  if [[ -n $pid ]] && tun_pid_alive "$pid"; then
    profile="$(jq -r '.profileId' <<<"$parsed")"
    iface="$(jq -r '.iface' <<<"$parsed")"
    # The id must look like a profile id, exactly as everywhere else in this
    # script. The file is root-written but its contents are still text; failing
    # closed HERE is what makes `status` and `tun-status` agree by construction,
    # and it keeps a crafted id from ever reaching a path join.
    [[ $profile =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || profile=""
    if [[ -n $profile && -n $iface ]]; then
      jq -c --arg pid "$pid" '. + {active: true, pid: $pid}' <<<"$parsed"
      return 0
    fi
  fi

  # ONE "off" shape, applied here for every caller. See the note above: a dead
  # pid, a missing name, a wrong-typed field and a malformed file all land on
  # this exact object.
  printf '%s' "$off"
}

# -----------------------------------------------------------------------------
# tun_last_error — one flattened line explaining the helper's last failure.
# -----------------------------------------------------------------------------
tun_last_error() {
  [[ -f $TUN_LAST_ERROR_FILE ]] || { printf ''; return 0; }
  # Same clamping rule as read_tun_state: never fail, never leak a parse error
  # into stdout, and never hand the panel unbounded text. The helper already
  # writes one line; flattening here also covers a hand-edited file.
  tr '\n\r' '  ' <"$TUN_LAST_ERROR_FILE" 2>/dev/null \
    | head -c 400 \
    | sed 's/  */ /g;s/^ //;s/ $//'
}

# -----------------------------------------------------------------------------
# tun_is_active — true when the root helper has a live TUN tunnel.
# -----------------------------------------------------------------------------
# One predicate for the four places that must agree about it (tun-up, tun-toggle
# and the start/toggle refusals). read_tun_state already drops a stale pid, so a
# dead tunnel never blocks anything.
tun_is_active() {
  [[ "$(jq -r '.active' <<<"$(read_tun_state)")" == true ]]
}

# -----------------------------------------------------------------------------
# TUN helper path and the pre-flight check before pkexec.
# -----------------------------------------------------------------------------
# The helper is executed AS ROOT, so the file it names must not be writable by
# the desktop user. The plugin itself lives in ~/.config/omarchy/plugins/, which
# the user owns — a "privileged half" installed there would be trivial to
# replace, and one pkexec password prompt later the replacement runs as root
# (silently, once a polkit rule names that path). So the executed copy is
# installed OUTSIDE the plugin tree, by `install-tun`, into a root-owned path.
#
# The environment override exists for tests. It is safe because the ownership
# check applies to whatever path it names: pointing it at a user-owned file only
# produces a refusal, never a prompt.
# The INSTALL destination is a constant and is deliberately NOT overridable:
# a root install must not take its target from the environment. The launch seam
# below is only for pointing the launcher/tests at the file that already exists.
TUN_HELPER_INSTALL_PATH=/usr/local/lib/omarchy-v2ray/omarchy-v2ray-tun
TUN_HELPER_PATH="${OMARCHY_V2RAY_TUN_HELPER:-$TUN_HELPER_INSTALL_PATH}"

# -----------------------------------------------------------------------------
# tun_helper_problem — echo why the helper path is unsafe to hand to pkexec, or
# nothing when it is usable.
# -----------------------------------------------------------------------------
# This is a PRE-FLIGHT, not the security boundary: it runs as the user, so a
# check-then-exec race is possible in principle. The boundary is the identical
# check the helper performs on its own $0 after pkexec has made it root; this
# one exists so an uninstalled or user-owned helper produces an actionable
# error instead of a password prompt followed by a failure.
tun_helper_problem() {
  local helper="${1:-}" owner mode
  [[ -n $helper ]] || { printf '%s' "the TUN helper path is empty"; return 0; }
  [[ $helper == /* ]] || { printf '%s' "the TUN helper path is not absolute"; return 0; }
  # A symlink is refused even if it points at a root-owned file: the link lives
  # in a directory whose owner chooses where it points.
  [[ -L $helper ]] && { printf '%s' "the TUN helper is a symlink"; return 0; }
  [[ -f $helper ]] || { printf '%s' "the TUN helper is not installed"; return 0; }
  [[ -x $helper ]] || { printf '%s' "the TUN helper is not executable"; return 0; }

  owner="$(stat -c '%u' -- "$helper" 2>/dev/null)" \
    || { printf '%s' "the TUN helper cannot be inspected"; return 0; }
  mode="$(stat -c '%a' -- "$helper" 2>/dev/null)" \
    || { printf '%s' "the TUN helper cannot be inspected"; return 0; }
  if [[ $owner != 0 ]]; then
    printf 'the TUN helper (%s) is not owned by root (uid %s), so a user could replace the code that runs as root' \
      "$helper" "$owner"
    return 0
  fi
  if (( (8#$mode & 8#022) != 0 )); then
    printf 'the TUN helper (%s) is group- or world-writable, so a user could replace the code that runs as root' \
      "$helper"
    return 0
  fi
  return 1
}

# -----------------------------------------------------------------------------
# tun_helper_source_path — the repo/plugin copy of the helper, to be installed.
# -----------------------------------------------------------------------------
# This path IS user-writable, by design: it is the source that `root` copies into
# place once, from a visible terminal showing the exact command. It must never be
# the path pkexec executes (see TUN_HELPER_PATH).
tun_helper_source_path() {
  local self="$0" dir
  # A bare name (found through PATH) has no slash; ask the shell where it found
  # us. Nothing here trusts a value from the environment.
  if [[ $self != */* ]]; then
    self="$(command -v -- "$self" 2>/dev/null)" || return 1
  fi
  [[ -n $self ]] || return 1
  dir="$(cd -- "$(dirname -- "$self")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/omarchy-v2ray-tun' "$dir"
}

# -----------------------------------------------------------------------------
# require_tun_helper — print the refusal and exit 1 when the helper may not be
# handed to pkexec; return 0 when it may.
# -----------------------------------------------------------------------------
# Split out of launch_tun_helper because `tun-up` has to ask this question
# BEFORE it stops the user's proxy engine: a missing helper must leave the
# working tunnel alone, and only a launch that can actually happen is allowed
# to have side effects.
require_tun_helper() {
  local helper="$TUN_HELPER_PATH" problem
  problem="$(tun_helper_problem "$helper")"
  if [[ -n $problem ]]; then
    # needsHelper is the panel's cue to offer "Install TUN helper" instead of a
    # password prompt that cannot work. Never invoke pkexec on this path.
    jq -n --arg error "$problem — install it with: omarchy-v2ray install-tun" \
      '{ok:false, error:$error, needsHelper:true}'
    exit 1
  fi
  command -v pkexec >/dev/null 2>&1 \
    || emit_error "pkexec is not installed, so the TUN password cannot be requested (install polkit)"
}

# -----------------------------------------------------------------------------
# launch_tun_helper VERB [ARG] — hand one request to pkexec and return at once.
# -----------------------------------------------------------------------------
# pkexec does not return until polkit has finished asking; the panel refreshes
# on a timer and must not sit on a password prompt. So the helper is launched
# fully detached (setsid, no tty, output discarded) and this script answers
# immediately. The caller then polls `status` / `tun-status`, which reads the
# state file the helper writes.
#
# `pkexec` is looked up by name on PATH here — that is the ONE program this
# script is allowed to escalate through, and it is always given the installed,
# checked helper path. There is no sudo fallback on purpose: sudo does not set
# PKEXEC_UID, and the helper refuses to guess its identity.
launch_tun_helper() {
  # `helper` is set HERE, never inherited from the function above: Bash `local`
  # is dynamically scoped, so require_tun_helper's copy is already gone when
  # this line runs. Under `set -u` the expansion then failed inside the FORKED
  # child (`setsid pkexec … &`), which the parent never notices — it printed
  # {"ok":true,"launched":true} while nothing had been launched at all.
  local verb="$1" id="${2:-}" helper="$TUN_HELPER_PATH"
  require_tun_helper

  if [[ -n $id ]]; then
    setsid pkexec "$helper" "$verb" "$id" >/dev/null 2>&1 &
  else
    setsid pkexec "$helper" "$verb" >/dev/null 2>&1 &
  fi
}

# free_port — find an unused local TCP port for a throwaway engine.
# We start at 11080 to stay clear of the real proxy ports (10808/10809).
free_port() {
  local candidate
  for candidate in $(seq 11080 11160); do
    if ! port_listening "$candidate"; then
      echo "$candidate"
      return 0
    fi
  done
  echo 11080
}

# config_path ID / meta_path ID — build the two file paths for a profile.
config_path() { echo "$PROFILES_DIR/$1.config.json"; }
meta_path() { echo "$PROFILES_DIR/$1.meta.json"; }

# profile_exists ID — true when both halves of a profile are present.
profile_exists() {
  [[ -f "$(meta_path "$1")" && -f "$(config_path "$1")" ]]
}

# last_log_lines COUNT — the tail of the engine log, flattened to one line so
# it can be embedded in a JSON error message.
# last_log_lines [COUNT] [FILE] — flatten the last COUNT lines of an engine log
# into one line, for stuffing into a JSON error message.
#
# BUG FIX: this used to read only $LOG_FILE. `ping` runs its throwaway engine
# with output going to a mktemp file instead, so every failed probe reported an
# empty detail — which is precisely the case where the engine's own words matter
# most. The file is now a parameter, and callers that use a temp log must pass it
# BEFORE they delete it.
last_log_lines() {
  local count="${1:-4}"
  local file="${2:-$LOG_FILE}"
  [[ -f $file ]] || { echo ""; return 0; }
  # Collapse runs of the SAME message before flattening. A failing REALITY probe
  # retries about once a second and the engine prints that one sentence every
  # time, so a naive tail produced four copies — which is what made the popup
  # unreadable and the bug report useless.
  #
  # The messages are NOT byte-identical though: xray prefixes every line with its
  # own timestamp and goroutine id, and both change on every retry. So the
  # comparison uses a NORMALISED key with the timestamp and [id] stripped; when a
  # run repeats, the first copy is printed verbatim and the count goes in
  # brackets. Only the text of the first line is kept, so a genuinely different
  # second message still shows up on its own.
  tail -n "$count" "$file" \
    | awk '
        {
          key = $0
          sub(/^[0-9][0-9][0-9][0-9]\/[0-9][0-9]\/[0-9][0-9] [0-9:.]+ /, "", key)
          sub(/\[[0-9]+\] /, "", key)
          if (key == prevkey) { n++; next }
          if (prevkey != "") print (n > 1 ? prev "  [repeated " n " times]" : prev)
          prev = $0; prevkey = key; n = 1
        }
        END { if (prevkey != "") print (n > 1 ? prev "  [repeated " n " times]" : prev) }
      ' \
    | tr '\n' ' ' \
    | sed 's/  */ /g;s/ *$//'
}

# -----------------------------------------------------------------------------
# Subcommand: status
# -----------------------------------------------------------------------------
# This is the single call the panel makes on its refresh timer. It answers, in
# one round trip: is a core installed, is the engine up, which profile is
# connected, on which ports, and for how long.
cmd_status() {
  ensure_dirs
  local engine installed=false running=false listening=false
  local pid active_id active_name="" socks="" http="" uptime=0 autostart=""
  local started=0 now=0
  # Which kind of connection the fields below describe: "tun", "proxy" or "off".
  # The panel needs this to label the connection honestly; the rest of the object
  # is deliberately unchanged, so every existing caller keeps working.
  local mode="off"

  engine="$(engine_bin)"
  [[ -n $engine ]] && installed=true

  pid="$(read_pid)"
  active_id="$( [[ -f $ACTIVE_FILE ]] && tr -d '\n' <"$ACTIVE_FILE" || echo "" )"
  autostart="$( [[ -f $AUTOSTART_FILE ]] && tr -d '\n' <"$AUTOSTART_FILE" || echo "" )"

  # TUN is a second, system-wide tunnel. Its state comes from the root-written
  # file (read_tun_state never fails), and `tunCanStart` is the panel's gate for
  # offering the switch: it repeats the two conditions the privileged slice will
  # enforce, so the UI can explain the block instead of offering a button that
  # cannot work. An already-active tunnel is its own block — the reason to say no
  # is not a missing package.
  local tun tun_active=false tun_profile="" tun_iface="" tun_since=0
  local tun_can_start=false tun_blocked=""
  tun="$(read_tun_state)"
  tun_active="$(jq -r '.active' <<<"$tun")"
  # read_tun_state validates profileId against the id rule and returns the fully
  # "off" shape on a bad one, so no path join below can see a crafted id.
  tun_profile="$(jq -r '.profileId' <<<"$tun")"
  tun_iface="$(jq -r '.iface' <<<"$tun")"
  tun_since="$(jq -r '.since' <<<"$tun")"

  if [[ $tun_active == true ]]; then
    tun_blocked="TUN is already active"
  else
    tun_blocked="$(tun_engine_reason "$engine")"
    [[ -z $tun_blocked ]] && tun_can_start=true
    # Nothing is cleared here on purpose: read_tun_state already returns every
    # field emptied/zeroed whenever active is false, and that is the single
    # "off means off" rule both `status` and `tun-status` share.
  fi

  if [[ -n $pid ]]; then
    running=true
    mode="proxy"
    if [[ -n $active_id && -f "$(config_path "$active_id")" ]]; then
      # Ports are read back from the profile that is actually running, so the
      # UI can show "SOCKS 127.0.0.1:10808" without duplicating our defaults.
      socks="$(jq -r '.inbounds[0].port // empty' "$(config_path "$active_id")" 2>/dev/null)"
      http="$(jq -r '.inbounds[1].port // empty' "$(config_path "$active_id")" 2>/dev/null)"
    fi
    listening=false
    [[ -n $socks ]] && port_listening "$socks" && listening=true
    [[ -f $STARTED_FILE ]] && started="$(tr -dc '0-9' <"$STARTED_FILE")"
    now="$(date +%s)"
    [[ -n $started ]] && uptime=$((now - started))
  else
    running=false
  fi

  # ONE SOURCE OF TRUTH FOR "CONNECTED" — and TUN wins.
  #
  # The panel derives its connected state from running/activeId/listening, and
  # gates `start`/`toggle` on the same fields. The TUN engine is a different
  # process with its own state file, so reporting only the proxy engine would
  # paint "Disconnected" while every packet on the machine was inside the
  # tunnel — and then invite a connect click that starts a second engine
  # competing for 10808. So while TUN is active it IS the connection, and the
  # fields are overwritten here, after the proxy branch, so exactly one set of
  # values ever leaves this function.
  if [[ $tun_active == true ]]; then
    mode="tun"
    running=true
    # `listening` means "the connection is live", not "a local port answers".
    # The helper only writes state.json after it has seen the profile's SOCKS
    # port listening inside the tunnel, so this is a fact rather than a guess;
    # re-probing the port here would just report a healthy tunnel as "engine
    # starting" during the seconds before it binds.
    listening=true
    pid="$(jq -r '.pid' <<<"$tun")"
    active_id="$tun_profile"
    socks=""
    http=""
    # The TUN engine runs the same config with a tun inbound added, so the
    # profile's proxy ports are still the ones bound and still worth showing.
    if [[ -n $active_id && -f "$(config_path "$active_id")" ]]; then
      socks="$(jq -r '.inbounds[0].port // empty' "$(config_path "$active_id")" 2>/dev/null)"
      http="$(jq -r '.inbounds[1].port // empty' "$(config_path "$active_id")" 2>/dev/null)"
    fi
    uptime=0
    if [[ $tun_since -gt 0 ]]; then
      uptime=$(( $(date +%s) - tun_since ))
      # A clock step backwards (or a state file written by a machine whose clock
      # was ahead) must not paint a negative uptime.
      (( uptime < 0 )) && uptime=0
    fi
  fi

  if [[ -n $active_id && -f "$(meta_path "$active_id")" ]]; then
    active_name="$(jq -r '.name // ""' "$(meta_path "$active_id")" 2>/dev/null)"
  fi

  # The helper's own account of why the last start failed. Always a string
  # (empty when there is nothing to say), so the panel can append it to the TUN
  # row without a null check. Read-only: this never creates the helper's dir.
  local tun_last_error
  tun_last_error="$(tun_last_error)"

  jq -n \
    --argjson installed "$installed" \
    --arg engine "$engine" \
    --argjson running "$running" \
    --argjson listening "$listening" \
    --arg pid "$pid" \
    --arg activeId "$active_id" \
    --arg activeName "$active_name" \
    --arg socksPort "$socks" \
    --arg httpPort "$http" \
    --argjson uptimeSec "$uptime" \
    --arg autostartId "$autostart" \
    --arg logTail "$(last_log_lines 3)" \
    --arg mode "$mode" \
    --argjson tunActive "$tun_active" \
    --arg tunProfileId "$tun_profile" \
    --arg tunIface "$tun_iface" \
    --argjson tunSince "$tun_since" \
    --argjson tunCanStart "$tun_can_start" \
    --arg tunBlockedReason "$tun_blocked" \
    --arg tunLastError "$tun_last_error" \
    '{
       ok: true,
       installed: $installed,
       engine: $engine,
       running: $running,
       listening: $listening,
       mode: $mode,
       pid: $pid,
       activeId: $activeId,
       activeName: $activeName,
       socksPort: (if $socksPort == "" then null else ($socksPort | tonumber) end),
       httpPort: (if $httpPort == "" then null else ($httpPort | tonumber) end),
       uptimeSec: $uptimeSec,
       autostartId: $autostartId,
       logTail: $logTail,
       tunActive: $tunActive,
       tunProfileId: $tunProfileId,
       tunIface: $tunIface,
       tunSince: $tunSince,
       tunCanStart: $tunCanStart,
       tunBlockedReason: $tunBlockedReason,
       tunLastError: $tunLastError
     }'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: tun-status
# -----------------------------------------------------------------------------
# A pure read, like `status`: does this machine have a core that can do TUN, and
# is a TUN tunnel already up according to the root-written state file? It starts
# and stops nothing, probes nothing, and needs no privileges. That is the whole
# point of this slice: the privileged half (`tun-up` / `tun-down`) does not exist
# yet, and nothing here may quietly grow a way to gain root.
cmd_tun_status() {
  local engine available=false reason=""
  engine="$(engine_bin)"
  reason="$(tun_engine_reason "$engine")"
  [[ -z $reason ]] && available=true

  local tun
  tun="$(read_tun_state)"

  jq -n \
    --argjson available "$available" \
    --arg engine "$engine" \
    --arg reason "$reason" \
    --argjson tun "$tun" \
    '{
       ok: true,
       available: $available,
       active: $tun.active,
       profileId: $tun.profileId,
       iface: $tun.iface,
       since: $tun.since,
       pid: $tun.pid,
       engine: $engine,
       reason: $reason
     }'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommands: tun-up / tun-down / tun-toggle
# -----------------------------------------------------------------------------
# These are thin launchers, not implementations. Everything privileged happens
# in bin/omarchy-v2ray-tun; everything here is validation the helper repeats
# anyway (it must never trust a caller) plus the detached pkexec hand-off.
cmd_tun_up() {
  local id="${1:-}"
  [[ -n $id ]] || emit_error "tun-up needs a profile id"
  # Same rule as import: never let a crafted id escape PROFILES_DIR. The helper
  # re-checks, because the process with root is the one that must not be fooled.
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || emit_error "invalid profile id"
  [[ $id != *".."* ]] || emit_error "invalid profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"

  # v2ray-core has no tun inbound and accepts the key silently; say so here so
  # the user is not sent through a password prompt for a tunnel that cannot
  # exist. Same wording and same `needsXray` flag as the proxy-mode gate.
  local engine reason
  engine="$(engine_bin)"
  reason="$(tun_engine_reason "$engine")"
  if [[ -n $reason ]]; then
    jq -n --arg error "$reason" '{ok:false, error:$error, needsXray:true}'
    exit 1
  fi

  # Avoid a second polkit prompt (and a twin helper) when the helper's own
  # flock would refuse anyway. A stale state file reads as inactive, so a dead
  # tunnel never blocks a restart.
  if tun_is_active; then
    emit_error "TUN is already active; run tun-down first"
  fi

  # The helper must be usable BEFORE the user's working tunnel is touched: a
  # missing helper has to leave the proxy engine running and answer needsHelper.
  require_tun_helper

  # Hand the local ports over to the privileged engine.
  #
  # WHY THIS IS HERE AT ALL: the TUN config is the profile's config with a tun
  # inbound added, so it still carries the profile's SOCKS/HTTP inbounds. If the
  # unprivileged engine is already running it owns 10808/10809, the privileged
  # one cannot bind, and it dies inside the helper's 10-second readiness wait —
  # surfacing as "the engine exited while the tunnel was starting", which says
  # nothing about the port collision that actually caused it. stop_engine needs
  # no privilege (same uid), so doing it here makes the handover explicit:
  # exactly one engine per profile at a time.
  stop_engine

  launch_tun_helper up "$id"
  # pkexec is still authenticating in the background. Answer now: the panel
  # polls tun-status, which will flip when the helper writes its state file.
  jq -n '{ok:true, launched:true, needsAuth:true}'
  exit 0
}

cmd_tun_down() {
  # Idempotent by construction: the helper exits 0 when nothing is running, and
  # it must also work after the profile has been deleted, so there is nothing to
  # validate here beyond finding the helper.
  #
  # TURNING OFF MUST NOT COST A PASSWORD. The privileged engine runs as the
  # INVOKING USER with only CAP_NET_ADMIN, so this user's own session may
  # signal it; the root supervisor (the `up` still running) then does the part
  # that needs root — restoring DNS, removing the routes and deleting the state
  # file — and this only has to wait for its evidence. Try that path first:
  #   * state active, pid present, /proc/<pid> exists, AND /proc/<pid>/comm is
  #     xray — a plain `kill -0` cannot be used since EPERM and ESRCH collapse
  #     (see tun_pid_alive), and a recycled pid must never be signalled on a
  #     stale file's word alone;
  #   * wait ~5s for the state file to disappear, which is how the supervisor
  #     signals completion;
  #   * on disappearance, the tunnel is off — report `stopped` with no pkexec
  #     at all. On anything else (no state file, dead pid, a supervisor that
  #     died before cleanup, a pid that is not an engine) the privileged
  #     fallback below still exists.
  local tun pid
  tun="$(read_tun_state)"
  if [[ "$(jq -r '.active' <<<"$tun")" == true ]]; then
    pid="$(jq -r '.pid' <<<"$tun")"
    # read_tun_state already validated the pid shape; the comm check is what
    # makes it safe to signal a pid that only a state file named.
    if [[ -n $pid && -d /proc/$pid ]] \
       && [[ "$(cat -- "/proc/$pid/comm" 2>/dev/null)" == "xray" ]]; then
      kill -TERM "$pid" 2>/dev/null || true
      local i
      for i in $(seq 1 25); do
        [[ -f $TUN_STATE_FILE ]] || break
        sleep 0.2
      done
      if [[ ! -f $TUN_STATE_FILE ]]; then
        jq -n '{ok:true, stopped:true}'
        exit 0
      fi
    fi
  fi

  launch_tun_helper down
  jq -n '{ok:true, launched:true}'
  exit 0
}

cmd_tun_toggle() {
  local id="${1:-}"
  if tun_is_active; then
    cmd_tun_down
  fi
  [[ -n $id ]] || emit_error "tun-toggle needs a profile id when TUN is not active"
  cmd_tun_up "$id"
}

# -----------------------------------------------------------------------------
# Subcommand: list
# -----------------------------------------------------------------------------
# Deliberately includes `link`: the panel offers a "copy link" action, and the
# data never leaves the user's own machine. Everything else comes from the meta
# file, so this stays a pure read — no engine involved, works while offline.
cmd_list() {
  ensure_dirs
  shopt -s nullglob
  local metas=("$PROFILES_DIR"/*.meta.json)
  shopt -u nullglob
  if (( ${#metas[@]} == 0 )); then
    echo '[]'
    exit 0
  fi
  jq -s '
    map({
      id: (.id // ""),
      name: (.name // "Unnamed"),
      type: (.type // ""),
      host: (.host // ""),
      port: (.port // 0),
      added: (.added // 0),
      link: (.link // ""),
      security: (.security // ""),
      network: (.network // "")
    })
    | sort_by(.name | ascii_downcase)
  ' "${metas[@]}"
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: import
# -----------------------------------------------------------------------------
# The panel parses the share link in JavaScript (where string handling is
# pleasant), then pipes us:
#
#   { "id": "<slug>", "meta": {...}, "config": {...} }
#
# We only validate and persist. Re-importing the same link produces the same id,
# so it updates the existing profile instead of creating a duplicate.
#
# THE PAYLOAD IS ACCEPTED ON STDIN AND NOWHERE ELSE
# ------------------------------------------------
# `config` carries the tunnel's credentials: the VLESS/Vmess user UUID, or the
# Trojan/Shadowsocks password. Two otherwise convenient channels are therefore
# off limits, and this is not theoretical — they are world-readable:
#
#   * argv. A command line can be read by any user on the machine for as long as
#     the process runs (`ps -ww`, /proc/<pid>/cmdline — no privileges needed), so
#     an argument payload paints the user's UUID into the process table, into
#     `top`/`htop`, into anything that samples or logs processes, and into the
#     shell history of whoever typed it. `import "<payload>"` was the original
#     calling convention; it is refused now, loudly, so an old invocation cannot
#     quietly keep leaking.
#   * the environment. $OMARCHY_V2RAY_PAYLOAD was the second convenience path and
#     is gone for exactly the same reason: /proc/<pid>/environ is equally public,
#     and it survives in the parent's environment block besides.
#
# Stdin is a pipe held only by the caller and this process, so it is the one
# channel we read. The panel writes the JSON there and closes the pipe (see
# Service.qml); the read below is bounded in size and in time so that a caller
# who forgets to close cannot hang us or exhaust memory. Both bounds refuse the
# read outright: an over-large payload is never truncated to fit, and EOF — not
# the clock — is what marks the end of a payload.
#
# Note that the payload is also never echoed: every diagnostic below describes
# the *shape* of the problem ("invalid import payload") and never quotes the
# offending text, because that text is a secret.
cmd_import() {
  ensure_dirs

  # An argv payload is refused rather than ignored: a caller following an older
  # README must be told that its import did not happen.
  if (($# > 0)); then
    emit_error "refusing an argv payload (a command line is world-readable via /proc) — pipe the JSON on stdin instead"
  fi

  # A tty on stdin means a human typed `omarchy-v2ray import` and is now waiting
  # for a prompt that will never come. Say what is expected instead of reading.
  if [[ -t 0 ]]; then
    emit_error "no payload: pipe the {id,meta,config} JSON on stdin, e.g. omarchy-v2ray import < payload.json"
  fi

  # `timeout` bounds how long we wait for the writer to close the pipe; `head -c`
  # bounds how much of it we take — one byte MORE than the ceiling, so that an
  # over-large payload is visible instead of being silently cut to fit. Capped at
  # the ceiling exactly, this read could not tell "a complete payload of that
  # size" from "a larger payload cut off here", and a cut landing just past a
  # valid JSON document would import with its tail quietly dropped.
  #
  # The status trailer is appended INSIDE the capture, where it does two jobs:
  # it stops the shell from stripping trailing newlines off the payload (a
  # payload padded with newlines past the ceiling would otherwise shrink to
  # almost nothing and look like a perfectly good small payload), and it carries
  # `head`'s exit status — 124 means `timeout` gave up on a writer that never
  # closed the pipe. SOH (\001) cannot occur in JSON text, so it can never be
  # confused with the payload itself.
  local captured read_status payload payload_bytes
  local sep=$'\001'
  captured="$( { timeout "$IMPORT_READ_TIMEOUT" head -c "$((IMPORT_MAX_BYTES + 1))"; printf '\001%s' "$?"; } )"
  read_status="${captured##*"$sep"}"
  payload="${captured%"$sep"*}"

  # EOF is what marks the end of a payload, so a read that never saw it is
  # incomplete: refuse it rather than accept a half-delivered stream.
  if (( read_status == 124 )); then
    emit_error "timed out after ${IMPORT_READ_TIMEOUT}s reading the import payload from stdin: the pipe was never closed"
  fi
  (( read_status == 0 )) || emit_error "could not read the import payload from stdin"

  [[ -n $payload ]] || emit_error "empty import payload: pipe the {id,meta,config} JSON on stdin"

  # Compare BYTES, not ${#payload}: a character count would let multibyte text
  # measure under the ceiling while being over it in bytes.
  payload_bytes="$(printf '%s' "$payload" | wc -c)"
  if (( payload_bytes > IMPORT_MAX_BYTES )); then
    emit_error "import payload too large: at most $IMPORT_MAX_BYTES bytes"
  fi

  # Validate the shape before touching the filesystem.
  echo "$payload" | jq -e '
      (.id | type == "string" and length > 0)
      and (.meta | type == "object")
      and (.config | type == "object")
      and ((.config.inbounds | type) == "array")
      and ((.config.outbounds | type) == "array")
    ' >/dev/null 2>&1 || emit_error "invalid or incomplete import payload: expected {id,meta,config} JSON on stdin, at most $IMPORT_MAX_BYTES bytes"

  local id
  id="$(echo "$payload" | jq -r '.id')"
  # Defence in depth: never let a crafted id escape PROFILES_DIR.
  [[ $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || emit_error "invalid profile id"
  [[ $id != *".."* ]] || emit_error "invalid profile id"

  local was_active=""
  [[ -f $ACTIVE_FILE ]] && was_active="$(tr -d '\n' <"$ACTIVE_FILE")"

  # Write atomically: a half-written config that the engine reads would be an
  # ugly class of bug, so each file goes to a temp name and is moved into place.
  local tmp_meta tmp_config
  tmp_meta="$PROFILES_DIR/.$id.meta.tmp"
  tmp_config="$PROFILES_DIR/.$id.config.tmp"

  echo "$payload" | jq -c --arg id "$id" '.meta + {id: $id}' >"$tmp_meta" || emit_error "could not write metadata"
  echo "$payload" | jq -c '.config' >"$tmp_config" || emit_error "could not write config"

  chmod 600 "$tmp_meta" "$tmp_config"
  mv -f "$tmp_meta" "$(meta_path "$id")"
  mv -f "$tmp_config" "$(config_path "$id")"

  # If we just replaced the profile that is currently connected, restart it so
  # the running tunnel matches what the user sees. This is the common case when
  # someone re-imports an updated link for the same server.
  local restarted=false
  if [[ -n $was_active && $was_active == "$id" ]]; then
    if [[ -n "$(read_pid)" ]]; then
      start_profile "$id" >/dev/null 2>&1 && restarted=true
    fi
  fi

  # Tell the panel up front when this link cannot run on the installed core, so
  # the user learns it at import time instead of at the first failed connect.
  # Same rule as require_capable_engine, reported as data rather than an error:
  # the import itself did succeed and the profile is worth keeping.
  local missing
  missing="$(xray_only_features "$id")"
  [[ "$(engine_bin)" == "xray" ]] && missing=""

  if [[ -n $missing ]]; then
    jq -n --arg id "$id" --argjson restarted "$restarted" --arg missing "$missing" \
      '{ok: true, id: $id, restarted: $restarted, needsXray: true, needsXrayReason: $missing}'
  else
    jq -n --arg id "$id" --argjson restarted "$restarted" \
      '{ok: true, id: $id, restarted: $restarted}'
  fi
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: remove
# -----------------------------------------------------------------------------
cmd_remove() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "remove needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"

  # Disconnect first, otherwise the engine keeps running against a config file
  # that no longer exists (which is fine, but confusing to debug later).
  local active=""
  [[ -f $ACTIVE_FILE ]] && active="$(tr -d '\n' <"$ACTIVE_FILE")"
  [[ $active == "$id" ]] && stop_engine

  rm -f "$(meta_path "$id")" "$(config_path "$id")"
  # Forget the autostart pointer if it named this profile.
  local auto=""
  [[ -f $AUTOSTART_FILE ]] && auto="$(tr -d '\n' <"$AUTOSTART_FILE")"
  [[ $auto == "$id" ]] && rm -f "$AUTOSTART_FILE"

  jq -n --arg id "$id" '{ok: true, id: $id}'
  exit 0
}

# -----------------------------------------------------------------------------
# Internal: start_profile ID
# -----------------------------------------------------------------------------
# Brings the engine up in the background and waits until the SOCKS port really
# accepts connections, so the UI never says "connected" for a tunnel that died
# on a bad config.
#
# THE DAEMONIZE TRICK: the caller is often a short-lived Quickshell `Process`
# item, and QProcess kills its children when it is destroyed. `setsid` plus a
# full detach (stdin </dev/null, stdout/stderr to the log) reparents the engine
# to init, so the tunnel outlives the script that launched it.
start_profile() {
  local id="$1"
  local config
  config="$(config_path "$id")"
  [[ -f $config ]] || { jq -n --arg e "unknown profile: $id" '{ok:false,error:$e}'; return 1; }

  local engine
  engine="$(engine_bin)"
  [[ -n $engine ]] || { jq -n '{ok:false,error:"no v2ray/xray engine installed",needsEngine:true}'; return 1; }

  # REALITY/XHTTP profiles cannot run on v2ray-core; say so now rather than
  # letting the engine start, hang, and get reported as a bad server.
  require_capable_engine "$id" "$engine" || return 1

  # Starting a second engine would fail on a taken port, so stop the old one.
  stop_engine >/dev/null 2>&1

  : >"$LOG_FILE"

  # `exec` inside the subshell keeps the PID we record identical to the engine's
  # PID, which matters for stop: we never want to signal a wrapper that has
  # already exited while the real engine keeps running.
  (
    exec setsid "$engine" run -c "$config" >>"$LOG_FILE" 2>&1 </dev/null
  ) &
  local pid=$!

  echo "$pid" >"$PID_FILE"
  echo "$id" >"$ACTIVE_FILE"
  date +%s >"$STARTED_FILE"

  local socks
  socks="$(jq -r '.inbounds[0].port' "$config" 2>/dev/null)"
  [[ -n $socks ]] || socks="$DEFAULT_SOCKS_PORT"

  # Poll for up to ~6 seconds. The engine usually binds in well under a second;
  # the generous window covers a cold disk and a slow first DNS lookup.
  local attempt
  for attempt in $(seq 1 40); do
    if ! process_alive "$pid"; then
      break
    fi
    if port_listening "$socks"; then
      jq -n --arg id "$id" --argjson pid "$pid" --argjson port "$socks" \
        '{ok: true, id: $id, pid: $pid, socksPort: $port}'
      return 0
    fi
    sleep 0.15
  done

  # Failure: clean up the state files so `status` does not report a ghost.
  local tail_text
  tail_text="$(last_log_lines 6)"
  rm -f "$PID_FILE" "$ACTIVE_FILE" "$STARTED_FILE"
  process_alive "$pid" && kill -TERM "$pid" 2>/dev/null
  jq -n --arg e "${tail_text:-engine exited immediately}" \
    '{ok:false,error:$e,failedToStart:true}'
  return 1
}

# -----------------------------------------------------------------------------
# Internal: stop_engine
# -----------------------------------------------------------------------------
stop_engine() {
  local pid
  pid="$(read_pid)"
  if [[ -n $pid ]]; then
    kill -TERM "$pid" 2>/dev/null
    local attempt
    for attempt in $(seq 1 25); do
      process_alive "$pid" || break
      sleep 0.2
    done
    # Escalate only if the engine ignored SIGTERM; xray normally exits at once.
    process_alive "$pid" && kill -KILL "$pid" 2>/dev/null
  fi
  rm -f "$PID_FILE" "$ACTIVE_FILE" "$STARTED_FILE"
}

# -----------------------------------------------------------------------------
# Subcommands: start / stop / restart / toggle
# -----------------------------------------------------------------------------
cmd_start() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "start needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"
  # One engine per set of local ports. While TUN is up the privileged engine owns
  # 10808/10809, so starting the user-side one would either fail to bind or —
  # worse — succeed after the TUN engine died, leaving `status` describing a
  # connection the machine is not actually using. The switch that turns TUN off
  # is the panel's TUN row (or `tun-down`), so say that instead of starting a
  # doomed second engine. The command is named as well because this refusal is
  # also reachable from a terminal, where there is no switch to click.
  tun_is_active && emit_error "TUN mode is on — turn it off from the TUN switch first, or run 'omarchy-v2ray tun-down'"
  start_profile "$id"
  exit $?
}

cmd_stop() {
  ensure_dirs
  stop_engine
  emit_ok '{"ok":true,"running":false}'
}

cmd_restart() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "restart needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"
  start_profile "$id"
  exit $?
}

# `toggle` is what the bar icon's right-click and the panel's big switch call.
# With no argument it reconnects the last profile, or the autostart one — that
# is what makes a single click on the bar feel like a VPN switch.
cmd_toggle() {
  ensure_dirs
  # Same rule as cmd_start: TUN owns the local ports, and a proxy engine started
  # underneath it would fight for them and desynchronise `status`. Refusing with
  # the way out is kinder than a start that dies 10 seconds later; the command is
  # named too, because this path is what the bar's right-click lands on.
  tun_is_active && emit_error "TUN mode is on — turn it off from the TUN switch first, or run 'omarchy-v2ray tun-down'"
  if [[ -n "$(read_pid)" ]]; then
    stop_engine
    emit_ok '{"ok":true,"running":false}'
  fi

  local id="${1:-}"
  if [[ -z $id && -f $ACTIVE_FILE ]]; then
    id="$(tr -d '\n' <"$ACTIVE_FILE")"
  fi
  if [[ -z $id && -f $AUTOSTART_FILE ]]; then
    id="$(tr -d '\n' <"$AUTOSTART_FILE")"
  fi
  # Last resort: if exactly one profile exists, use it (a single-server setup
  # should not require picking anything).
  if [[ -z $id ]]; then
    shopt -s nullglob
    local metas=("$PROFILES_DIR"/*.meta.json)
    shopt -u nullglob
    [[ ${#metas[@]} -eq 1 ]] && id="$(jq -r '.id' "${metas[0]}")"
  fi
  [[ -n $id ]] || emit_error "no profile to connect; import one first"

  start_profile "$id"
  exit $?
}

# -----------------------------------------------------------------------------
# Subcommand: ping
# -----------------------------------------------------------------------------
# Measures the latency the user will actually feel: a real handshake through a
# throwaway engine, not a TCP connect to the server's port (which would report
# a happy 40 ms for a server whose UUID has been revoked).
#
# The profile's real config is reused with jq-patched ports, so we test exactly
# the same settings, just on a spare port that does not disturb the live tunnel.
cmd_ping() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "ping needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"

  local engine
  engine="$(engine_bin)"
  [[ -n $engine ]] || { jq -n '{ok:false,error:"no v2ray/xray engine installed",needsEngine:true}'; exit 0; }

  # Same capability gate as start_profile: a REALITY profile probes as "no
  # response" on v2ray-core, which would blame the server for our own gap.
  require_capable_engine "$id" "$engine" || exit 0

  # A private temp DIRECTORY, not two bare mktemp files.
  #
  # BUG FIX (this one produced a completely misleading error message): xray's
  # `-format auto` picks the config format from the file extension. `mktemp`
  # hands back /tmp/tmp.a1b2c3d4 — no extension — and xray responds
  #     Failed to start: ... core: Failed to get format of /tmp/tmp.a1b2c3d4
  # and exits before binding anything. The probe engine never came up, yet the
  # user was told "bad UUID, wrong server, or blocked port". Naming the file
  # config.json fixes the root cause.
  local socks_port http_port tmp_dir tmp_config tmp_log pid
  socks_port="$(free_port)"
  http_port=$((socks_port + 1))
  tmp_dir="$(mktemp -d)"
  tmp_config="$tmp_dir/config.json"
  tmp_log="$tmp_dir/engine.log"

  # Patch both inbound ports to the spare pair.
  jq -c --argjson socks "$socks_port" --argjson http "$http_port" \
    '.inbounds[0].port = $socks | .inbounds[1].port = $http' \
    "$(config_path "$id")" >"$tmp_config" || { rm -f "$tmp_config" "$tmp_log"; rmdir "$tmp_dir" 2>/dev/null; emit_error "could not prepare probe config"; }

  setsid "$engine" run -c "$tmp_config" >>"$tmp_log" 2>&1 </dev/null &
  pid=$!

  # Wait for the probe engine to bind its SOCKS port before asking it anything.
  local attempt
  for attempt in $(seq 1 30); do
    port_listening "$socks_port" && break
    process_alive "$pid" || break
    sleep 0.1
  done

  # Ask curl for BOTH the HTTP status and the elapsed time. Checking the status
  # (and curl's own exit code) is what stops a hung or refusing proxy from being
  # reported as a fast server: curl prints "000 0.001" when it never spoke to
  # anyone, and that must not become a triumphant "0 ms".
  # curl_status starts at -1, NOT 1, and http_code starts EMPTY, NOT "000".
  #
  # WHY THIS MATTERS: with the old initial values, "the probe engine never came
  # up" was indistinguishable from "the tunnel was up but no reply came back",
  # because an unset http_code of "000" matched the same branch. The message
  # then accused the server of being wrong. -1 and "" can only mean "curl never
  # ran", so each failure gets its own honest sentence.
  local result="" curl_status=-1 http_code="" time_total="" ms=0
  if port_listening "$socks_port"; then
    result="$(curl --max-time "$PING_TIMEOUT" -s -o /dev/null -w '%{http_code} %{time_total}' \
      --proxy "socks5h://127.0.0.1:$socks_port" "$PING_URL" 2>/dev/null)"
    curl_status=$?
    http_code="${result%% *}"
    time_total="${result##* }"
  fi

  kill -TERM "$pid" 2>/dev/null
  # Give the child a moment to die so we do not leak a listener on the spare port.
  for attempt in $(seq 1 20); do
    process_alive "$pid" || break
    sleep 0.05
  done
  process_alive "$pid" && kill -KILL "$pid" 2>/dev/null

  # Read the probe's own log BEFORE removing it. This is the engine's account of
  # what went wrong, and it is useless once the file is gone.
  #
  # TWO readings of the same tail, on purpose:
  #   probe_detail      — repeats collapsed, for the popup's one red line
  #   probe_detail_raw  — untouched, for `detailFull` / "copy details" / bug reports
  # Collapsing is lossy, so the un-collapsed text has to be captured separately;
  # deriving one from the other would quietly throw the repeats away.
  local probe_detail probe_detail_raw
  probe_detail="$(last_log_lines 4 "$tmp_log")"
  probe_detail_raw="$(tail -n 4 "$tmp_log" 2>/dev/null | tr '\n' ' ' | sed 's/  */ /g;s/ *$//')"
  local probe_ran=false
  [[ -s $tmp_log ]] && probe_ran=true

  # Read the engine's verdict while the log still exists. "received real
  # certificate" means the server answered with the genuine certificate of the
  # domain we are pretending to be — i.e. it refused the REALITY handshake and fell
  # back to proxying. That is a MUCH more specific story than "the tunnel did not
  # answer", and it is the one case users hit most often, so it gets its own
  # sentence and points at the command that explains it further.
  local declined=false
  grep -q 'received real certificate' "$tmp_log" 2>/dev/null && declined=true
  rm -f "$tmp_config" "$tmp_log"
  rmdir "$tmp_dir" 2>/dev/null

  # A real measurement needs: curl succeeded (0), an HTTP 2xx/3xx came back, and
  # a positive duration. Anything else means the tunnel did not actually carry
  # traffic, which is exactly what the user needs to be told.
  if [[ $curl_status -eq 0 && $http_code =~ ^[23] && -n $time_total ]]; then
    ms="$(awk -v t="$time_total" 'BEGIN { printf "%d", t * 1000 }')"
    if (( ms > 0 )); then
      jq -n --argjson ms "$ms" --argjson port "$socks_port" \
        '{ok:true, ms:$ms, probePort:$port}'
      exit 0
    fi
  fi

  # Explain the failure in terms the user can act on, in the order the layers
  # actually fail: engine -> proxy port -> tunnel -> reply.
  local reason
  if (( curl_status == -1 )); then
    # Keep this one short: the engine's own words go in `detail`, which the
    # popup already appends, and pasting them here too would double them up.
    reason="the probe engine never started"
  elif (( curl_status == 28 )); then
    reason="timed out after ${PING_TIMEOUT}s"
  elif (( curl_status == 7 )); then
    reason="the engine never opened a local proxy port"
  elif [[ $declined == true ]]; then
    reason="the server refused the REALITY handshake — it replied with the real certificate of the domain instead of accepting us, so the injected uuid/public key/short id was rejected (or our clock is too far off for the server's maxTimeDiff). Run 'bin/omarchy-v2ray debug <id>' for the handshake details"
  else
    reason="the tunnel did not answer (bad UUID, wrong public key, unreachable server, or blocked port)"
  fi
  # The popup paints "<error> (<detail>)" on ONE red line. xray's debug lines are
  # hundreds of characters long, so the raw tail turned the popup into a wall of
  # unreadable text. `detail` is therefore clamped to two folded lines; the
  # untouched log is still returned as `detailFull`, which the popup offers behind
  # a "Copy details" button and which is what you paste into a bug report.
  local detail_short
  detail_short="$(printf '%s' "$probe_detail" \
    | fold -s -w 160 \
    | head -2 \
    | tr '\n' ' ' \
    | sed 's/  */ /g;s/ *$//')"
  jq -n --arg e "$reason" --arg d "$detail_short" --arg df "$probe_detail_raw" \
        --argjson ran "$probe_ran" \
    '{ok:false, error:$e, detail:$d, detailFull:$df, engineLogged:$ran}'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: debug
# -----------------------------------------------------------------------------
# The "why is my server not working" command. Everything the plugin does is
# invisible — two short-lived engine runs and a curl between them — so when a
# tunnel fails there is nothing on screen to inspect. This runs the SAME engine
# with the SAME config, but:
#
#   * on spare ports, so it never disturbs a live tunnel,
#   * with loglevel forced to "debug", so the handshake is actually narrated,
#   * in the foreground long enough for a real request to go through, and
#   * prints a report that includes the engine's full log.
#
# It is deliberately verbose. The point is to be pasteable into a bug report.
cmd_debug() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "debug needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"

  local engine
  engine="$(engine_bin)"
  [[ -n $engine ]] || { jq -n '{ok:false,error:"no v2ray/xray engine installed",needsEngine:true}'; exit 0; }

  require_capable_engine "$id" "$engine" || exit 0

  # Same .json-extension requirement as cmd_ping — see the long note there.
  local socks_port http_port tmp_dir tmp_config tmp_log pid

  # REGRESSION GUARD — two separate traps live in these five lines.
  #
  # 1. ORDER. address/server_ip/server_port/sni are declared here but assigned
  #    much further down, because their values come out of the profile config.
  #    They must be declared before the handshake-note block below, which mentions
  #    $sni. Declared later, the first use aborts the whole command with
  #    "sni: unbound variable", and it only fires when the engine actually logged
  #    "received real certificate" — i.e. exactly when the report matters most.
  #
  # 2. THE `=""`. This script runs under `set -u`, and a bare `local name` does
  #    NOT mark the variable as set in Bash:
  #
  #        set -u; f() { local b; echo "$b"; }; f      # => b: unbound variable
  #
  #    Declaring without a value is therefore not enough — it has to be assigned.
  #    That one missing `=""` is what crashed this command for real.
  local address="" server_ip="" server_port="" sni=""
  socks_port="$(free_port)"
  http_port=$((socks_port + 1))
  tmp_dir="$(mktemp -d)"
  tmp_config="$tmp_dir/config.json"
  tmp_log="$tmp_dir/engine.log"

  # Force debug logging. `log.loglevel` is the only knob that decides whether
  # the REALITY/TLS handshake failure is narrated or swallowed.
  jq -c --argjson socks "$socks_port" --argjson http "$http_port" \
    '.log.loglevel = "debug" | .inbounds[0].port = $socks | .inbounds[1].port = $http' \
    "$(config_path "$id")" >"$tmp_config" 2>/dev/null \
    || { rm -f "$tmp_config" "$tmp_log"; rmdir "$tmp_dir" 2>/dev/null; emit_error "could not prepare debug config"; }

  setsid "$engine" run -c "$tmp_config" >>"$tmp_log" 2>&1 </dev/null &
  pid=$!

  # Wait for the proxy to accept connections, but also notice an early death:
  # a config or bind error kills the engine in milliseconds and the log says why.
  local attempt engine_alive=false engine_died=false listening=false
  for attempt in $(seq 1 60); do
    if port_listening "$socks_port"; then listening=true; break; fi
    if ! process_alive "$pid"; then engine_died=true; break; fi
    sleep 0.1
  done
  process_alive "$pid" && engine_alive=true

  # -1 / "" can only mean "curl never ran" — the same sentinel rule cmd_ping uses,
  # so "the engine never came up" can never be reported as "the server did not
  # answer". With the old 1 / "000" pair those two were indistinguishable.
  local curl_status=-1 http_code="" time_total="" probe_detail=""
  if [[ $listening == true ]]; then
    # -w prints "<http status> <seconds>" on one line, and a failed tunnel
    # prints "000 0.000000" rather than nothing, so we can always tell "the
    # request failed" apart from "curl never ran".
    local result
    result="$(curl --max-time "${DEBUG_TIMEOUT:-12}" -s -o /dev/null \
      -w '%{http_code} %{time_total}' \
      --proxy "socks5h://127.0.0.1:$socks_port" "$PING_URL" 2>/dev/null)"
    curl_status=$?
    http_code="${result%% *}"
    time_total="${result##* }"
  fi

  # Unconditional snapshot: every branch below wants it.
  #
  # NOTE: unlike the one-line flattening used inside JSON error fields, the debug
  # report keeps the log's real newlines. Someone has to read this, and a
  # 60-line log squashed onto one line is not readable.
  probe_detail_flattened="$(last_log_lines 60 "$tmp_log")"
  probe_detail="$(tail -n 60 "$tmp_log" 2>/dev/null)"

  kill -TERM "$pid" 2>/dev/null
  for attempt in $(seq 1 20); do
    process_alive "$pid" || break
    sleep 0.05
  done
  process_alive "$pid" && kill -KILL "$pid" 2>/dev/null
  rm -f "$tmp_config" "$tmp_log"
  rmdir "$tmp_dir" 2>/dev/null

  # One-line verdict, in the order the layers fail.
  local verdict
  if [[ $engine_died == true ]]; then
    verdict="the engine refused to start (see the log: a bad config or a taken port)"
  elif [[ $listening == false ]]; then
    verdict="the engine never opened its local proxy port"
  elif [[ $http_code =~ ^[23] ]]; then
    verdict="THE TUNNEL WORKS — request returned HTTP $http_code in ${time_total}s"
  else
    verdict="the engine ran, but no reply came back through the tunnel (HTTP $http_code, curl exit $curl_status)"
  fi

  # (declared at the top of this function — see the regression note there)
  server_ip="$(jq -r '.outbounds[] | select(.tag=="proxy") | .settings.vnext[0].address' "$(config_path "$id")" 2>/dev/null)"
  server_port="$(jq -r '.outbounds[] | select(.tag=="proxy") | .settings.vnext[0].port' "$(config_path "$id")" 2>/dev/null)"
  sni="$(jq -r '.outbounds[] | select(.tag=="proxy") | .streamSettings.realitySettings.serverName // .streamSettings.tlsSettings.serverName // ""' "$(config_path "$id")" 2>/dev/null)"
  address="$server_ip:$server_port"

  # ---- two extra probes, both aimed at the "received real certificate" family
  # of failures, because that is the one message that cannot be read on its own.

  # 1. Clock drift, measured against a host we can reach without the tunnel.
  local skew skew_text
  skew="$(clock_skew_seconds "$PING_HOST_FOR_CLOCK")"
  if [[ -n $skew ]]; then skew_text="${skew}s"; else skew_text="unknown"; fi

  # 2. Certificate identity. `server_cert` is what the server IP presents for our
  #    SNI; `direct_cert` is what the genuine domain presents. A REALITY server
  #    that declines our auth falls back to proxying to the real domain, so for a
  #    healthy-but-unauthenticated setup BOTH should be the real domain's
  #    certificate. If the two disagree, the IP is being redirected somewhere
  #    else entirely — a network problem, not a config problem.
  local server_cert direct_cert
  server_cert="$(probe_cert "$server_ip" "$server_port" "$sni")"
  direct_cert="$(probe_cert "$sni" 443 "$sni")"

  local have_openssl=false
  command -v openssl >/dev/null 2>&1 && have_openssl=true

  # Compare the signing ORGANISATION, not the whole subject+issuer string. See
  # ca_of(): different Google datacenters legitimately sign with different issuer
  # CNs (WE2 vs WR2) for the very same domain, and treating that as an attack
  # produced a false "MISMATCH" on a connection that was in fact working.
  local server_ca direct_ca
  server_ca="$(ca_of "$server_cert")"
  direct_ca="$(ca_of "$direct_cert")"

  local network_note
  if [[ $have_openssl == false ]]; then
    network_note="not checked (openssl is not installed)"
  else
    network_note="no TLS handshake could be completed from this machine"
  fi

  if [[ -n $server_cert || -n $direct_cert ]]; then
    if [[ -z $server_cert ]]; then
      network_note="could not complete a TLS handshake with $address at all"
    elif [[ -z $direct_cert ]]; then
      network_note="server presents: $server_cert (could not reach $sni directly to compare)"
    elif [[ -n $server_ca && $server_ca == "$direct_ca" ]]; then
      # Same signer => this really is the domain behind the IP. Report the two
      # raw strings anyway, so the "but they look different!" follow-up answers
      # itself: the issuer CN differs while the organisation matches.
      network_note="the $address IP presents a certificate signed by the same authority as the real $sni ($server_ca). The path is clean — a differing issuer CN (WE2 vs WR2) is just a different Google front, and is NOT interception."
    else
      network_note="MISMATCH — $address presents a certificate signed by '$server_ca' while the real $sni uses '$direct_ca'. Something in the network path may be intercepting or redirecting it."
    fi
  fi

  # Screen-read the engine's own narration and turn it into one sentence. The
  # certificate comparison above cannot tell "we authenticated and then the reply
  # was slow" apart from "we never authenticated at all" — the engine log can:
  #
  #   * "XtlsFilterTls found tls client hello" / "tunneling request to" appears
  #     ONLY after REALITY accepted our credentials and handed the request to the
  #     server. A failure AFTER those lines is a LATE failure (no reply in time),
  #     not a credential problem.
  #   * "received real certificate" is the opposite: the server answered with its
  #     fallback certificate, i.e. it rejected us.
  #
  # It runs HERE, not earlier, for two reasons: it needs $sni for its wording, and
  # it greps the log we already copied into $probe_detail instead of re-reading a
  # file that has been deleted by now.
  # ---- how long did the OUTER REALITY handshake take? ------------------------
  # Why this matters: on a slow uplink the engine can spend most of the deadline
  # just completing the REALITY handshake. The request then times out and the
  # report used to look identical to "bad link" / "broken server", even though
  # the credentials were accepted. Measuring the two moments removes the doubt:
  #
  #   * t0 = the line where the engine ACCEPTED our SOCKS request
  #          (`... accepted tcp:... [socks-in >> proxy]`).
  #   * t1 = the line where the engine HANDED the request to the server
  #          (`tunneling request to ...` or `XtlsFilterTls found tls client hello`).
  #   * t1 - t0 = seconds the outer handshake consumed.
  #
  # Xray timestamps are `YYYY/MM/DD HH:MM:SS.ffffff` and all lines belong to the
  # same run, so plain seconds-of-day arithmetic is enough — no date library and
  # no dependency on `date -d` (which BSD/macOS would spell differently).
  local handshake_seconds
  handshake_seconds="$(awk '
    $2 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]\.[0-9]+$/ {
      split($2, t, ":")                       # t[1]=HH t[2]=MM t[3]=SS.ffffff
      sec = t[1] * 3600 + t[2] * 60 + t[3]    # seconds of day, fractional part kept
      if (t0 == "" && /\[socks-in >> proxy\]/) t0 = sec
      if (t1 == "" && (/XtlsFilterTls found tls client hello/ || /tunneling request to/)) t1 = sec
    }
    END { if (t0 != "" && t1 != "" && t1 >= t0) printf "%.2f", t1 - t0 }
  ' <<<"$probe_detail")"

  # Sentence appended to the handshake note only when we actually measured it.
  local handshake_timing=""
  if [[ -n $handshake_seconds ]]; then
    handshake_timing=" The outer REALITY handshake alone took ${handshake_seconds}s of the ${DEBUG_TIMEOUT:-12}s deadline."
  fi

  local handshake_note
  if grep -qE 'XtlsFilterTls found tls client hello|tunneling request to' <<<"$probe_detail"; then
    handshake_note="REALITY authentication SUCCEEDED (the engine forwarded a TLS ClientHello into the tunnel), so the server accepted the uuid / public key / short id. The failure is later: no reply came back within the ${DEBUG_TIMEOUT:-12}s deadline. That points at a slow or blocked uplink, or a broken server — NOT at a bad link.${handshake_timing}"
  elif grep -q 'received real certificate' <<<"$probe_detail"; then
    handshake_note="the $address server answered with the REAL certificate of $sni instead of completing a REALITY handshake, which means it rejected our credentials (uuid, public key or short id) — or our clock is too far from the server's for its maxTimeDiff — or something on the path is redirecting us.${handshake_timing}"
  else
    handshake_note="no handshake evidence in the engine log (the engine never got far enough to try one)."
  fi

  local report
  report="$(printf '%s\n' \
    "v2ray-client debug report" \
    "  profile        : $id" \
    "  engine         : $engine ($("$engine" version 2>/dev/null | head -1))" \
    "  server         : ${address:-unknown}" \
    "  probe ports    : socks=$socks_port http=$http_port" \
    "  engine started : $engine_alive (died early: $engine_died)" \
    "  socks open     : $listening" \
    "  request result : HTTP ${http_code:-n/a} after ${time_total:-n/a}s (curl exit $curl_status)" \
    "  target         : $PING_URL" \
    "  clock skew     : $skew_text (local clock minus a directly-reached TLS server)" \
    "  server cert    : ${server_cert:-unavailable}" \
    "  real $sni cert : ${direct_cert:-unavailable}" \
    "  network note   : $network_note" \
    "  handshake time : ${handshake_seconds:-n/a}s (request accepted -> forwarded into the tunnel)" \
    "  handshake      : $handshake_note" \
    "  verdict        : $verdict" \
    "" \
    "--- engine log (debug level) ---" \
    "$probe_detail")"

  # A clock that is minutes off is its own, easily-missed failure. Say so loudly.
  if [[ -n $skew ]] && { (( skew > 5 )) || (( skew < -5 )); }; then
    report="$report

!! Your clock is off by ${skew}s. REALITY embeds a timestamp in every handshake,
   and a server with maxTimeDiff set will reject a client whose clock has drifted —
   with the same 'received real certificate' error. Fix with:
       sudo systemctl restart systemd-timesyncd && sudo systemctl restart systemd-time-wait-sync"
  fi

  jq -n --arg report "$report" --arg engine "$engine" \
    --argjson socksPort "$socks_port" --argjson listening "$listening" \
    --argjson engineAlive "$engine_alive" --argjson engineDied "$engine_died" \
    --argjson curlStatus "$curl_status" --arg httpCode "$http_code" \
    --arg timeTotal "$time_total" --arg address "$address" \
    --arg verdict "$verdict" --arg log "$probe_detail_flattened" \
    --arg clockSkew "$skew" --arg serverCert "$server_cert" \
    --arg directCert "$direct_cert" --arg networkNote "$network_note" \
    --arg handshakeNote "$handshake_note" \
    --arg handshakeSeconds "$handshake_seconds" \
    '{ok:true, report:$report, engine:$engine, socksPort:$socksPort,
      listening:$listening, engineAlive:$engineAlive, engineDied:$engineDied,
      curlStatus:$curlStatus, httpCode:$httpCode, timeTotal:$timeTotal,
      serverAddress:$address, verdict:$verdict, engineLog:$log,
      clockSkewSeconds:$clockSkew, serverCertificate:$serverCert,
      realDomainCertificate:$directCert, networkNote:$networkNote,
      handshakeNote:$handshakeNote, handshakeSeconds:$handshakeSeconds}'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: link
# -----------------------------------------------------------------------------
# Print just the original share link (used by the panel's "copy link" action).
# Trailing newline is intentional; the caller trims.
cmd_link() {
  ensure_dirs
  local id="${1:-}"
  [[ -n $id ]] || emit_error "link needs a profile id"
  profile_exists "$id" || emit_error "unknown profile: $id"
  jq -r '.link // ""' "$(meta_path "$id")"
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: log
# -----------------------------------------------------------------------------
# Plain text, not JSON: this one is for humans debugging in a terminal.
cmd_log() {
  ensure_dirs
  [[ -f $LOG_FILE ]] || { echo "no engine log yet"; exit 0; }
  tail -n "${1:-30}" "$LOG_FILE"
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: autostart
# -----------------------------------------------------------------------------
# Stored as a file rather than a systemd unit: the shell reads it on start, so
# it needs no privileged install step and can be turned off by deleting a file.
cmd_autostart() {
  ensure_dirs
  local id="${1:-}"
  if [[ -z $id ]]; then
    [[ -f $AUTOSTART_FILE ]] && { tr -d '\n' <"$AUTOSTART_FILE"; echo; } || echo "off"
    exit 0
  fi
  if [[ $id == "off" ]]; then
    rm -f "$AUTOSTART_FILE"
    emit_ok '{"ok":true,"autostartId":""}'
  fi
  profile_exists "$id" || emit_error "unknown profile: $id"
  echo "$id" >"$AUTOSTART_FILE"
  jq -n --arg id "$id" '{ok:true, autostartId:$id}'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: install-engine
# -----------------------------------------------------------------------------
# Hands the install to a visible terminal, because pacman needs a password and
# we are not allowed to prompt from inside the shell process.
cmd_install_engine() {
  if [[ -n "$(engine_bin)" ]]; then
    emit_ok '{"ok":true,"alreadyInstalled":true}'
  fi
  # We install `v2ray`, NOT `xray`.
  #
  # There is no `xray` package in Arch's official repositories. Searching for
  # "xray" there turns up `python-aws-xray-sdk`, which is Amazon's X-Ray tracing
  # SDK for Python and completely unrelated to this plugin. The proxy core named
  # xray only exists in the AUR, so a `omarchy pkg add xray` line would simply
  # fail for most users.
  #
  # `extra/v2ray` is the official package and covers the link types we import.
  # Users who need REALITY/XHTTP can additionally install the AUR xray with
  #   omarchy pkg aur add xray        (or: yay -S xray)
  # and this script will then prefer it automatically (see engine_bin above).
  local install_cmd="omarchy pkg add v2ray"
  local launcher="omarchy-launch-floating-terminal-with-presentation"
  if command -v "$launcher" >/dev/null 2>&1; then
    # `which` guard above means this is the omarchy wrapper; fall back to a
    # plain terminal for other desktops.
    setsid "$launcher" "$install_cmd" >/dev/null 2>&1 &
  else
    setsid xdg-terminal-exec "$install_cmd" >/dev/null 2>&1 &
  fi
  emit_ok '{"ok":true,"launched":true}'
}

# -----------------------------------------------------------------------------
# Subcommand: install-xray
# -----------------------------------------------------------------------------
# The optional upgrade path. xray lives in the AUR, not in the official repos,
# so this one needs an AUR helper. `omarchy pkg aur add` is Omarchy's wrapper
# around whichever helper the user has; we fall back to a bare `yay -S xray`
# when that subcommand is missing (older Omarchy).
cmd_install_xray() {
  if [[ "$(engine_bin)" == "xray" ]]; then
    emit_ok '{"ok":true,"alreadyInstalled":true}'
  fi

  # Pick the command that actually exists on this machine.
  #
  # `omarchy pkg aur add` is Omarchy's wrapper around whichever AUR helper the
  # user has, and it is the friendlier of the two (it skips the install when the
  # package is already there). It only exists on newer Omarchy builds, and
  # `omarchy pkg aur --help` is NOT a valid probe — that prints "Unknown Omarchy
  # command" — so we look for the subcommand in the real help text instead.
  local install_cmd="yay -S xray"
  if omarchy pkg --help 2>/dev/null | grep -q 'pkg aur add'; then
    install_cmd="omarchy pkg aur add xray"
  fi

  local launcher="omarchy-launch-floating-terminal-with-presentation"
  if command -v "$launcher" >/dev/null 2>&1; then
    setsid "$launcher" "$install_cmd" >/dev/null 2>&1 &
  else
    setsid xdg-terminal-exec "$install_cmd" >/dev/null 2>&1 &
  fi
  jq -n --arg cmd "$install_cmd" '{ok:true, launched:true, command:$cmd}'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: install-tun
# -----------------------------------------------------------------------------
# Installs the PRIVILEGED helper outside the plugin tree.
#
# WHY THIS EXISTS: the plugin is installed under ~/.config/omarchy/plugins/,
# which the desktop user owns. A helper that pkexec executes from there is not
# privileged at all — any process running as that user can replace it and have
# the replacement run as root on the next prompt (and silently once a polkit
# rule names the path). So the executed copy lives at
# /usr/local/lib/omarchy-v2ray/omarchy-v2ray-tun, root-owned and 0755, and both
# this script and the helper check that before anything privileged happens.
#
# Like install-engine, the install runs in a VISIBLE terminal: pkexec needs a
# password, this script has no TTY, and the user should see exactly what root is
# about to copy. The command is shown in the terminal and in the JSON reply.
cmd_install_tun() {
  # THE DESTINATION IS A CONSTANT, NEVER $TUN_HELPER_PATH. That variable is a
  # LAUNCH seam: it lets the launcher (and the tests) point at an already
  # installed file. Using it here would let the environment choose what root
  # overwrites — OMARCHY_V2RAY_TUN_HELPER=/etc/passwd would produce a root
  # `install` over /etc/passwd. Installation and launching are different
  # authorities, so they get different seams.
  local dest="$TUN_HELPER_INSTALL_PATH" src owner mode install_cmd
  local dir
  dir="$(dirname -- "$dest")"

  # Never overwrite something that is not already ours to overwrite. A symlink
  # is refused even when it points at a root-owned file, because the link's
  # directory decides where it points; a non-root-owned file may be a previous
  # install the user should look at; a group/world-writable one is exactly the
  # hazard this whole subcommand exists to remove.
  [[ -L $dest ]] && emit_error "refusing to install over a symlink: $dest"
  if [[ -e $dest ]]; then
    [[ -f $dest ]] || emit_error "refusing to overwrite a non-regular file: $dest"
    owner="$(stat -c '%u' -- "$dest" 2>/dev/null)" \
      || emit_error "cannot inspect $dest"
    mode="$(stat -c '%a' -- "$dest" 2>/dev/null)" \
      || emit_error "cannot inspect $dest"
    [[ $owner == 0 ]] \
      || emit_error "refusing to overwrite $dest: it is not owned by root (uid $owner). Remove it yourself, then rerun"
    (( (8#$mode & 8#022) == 0 )) \
      || emit_error "refusing to overwrite $dest: it is group- or world-writable"
  fi

  # The INSTALL DIRECTORY is checked too: `install -D` creates a missing one but
  # will happily write through a pre-existing directory that somebody else owns
  # or can rewrite. `install -d` inside the pkexec chain fixes the mode/owner,
  # but a bad existing directory must be reported, not silently "repaired" into
  # a path the user never audited.
  [[ -L $dir ]] && emit_error "refusing a symlinked install directory: $dir"
  if [[ -e $dir ]]; then
    [[ -d $dir ]] || emit_error "refusing to install into a non-directory: $dir"
    owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" \
      || emit_error "cannot inspect the install directory"
    mode="$(stat -c '%a' -- "$dir" 2>/dev/null)" \
      || emit_error "cannot inspect the install directory"
    [[ $owner == 0 ]] \
      || emit_error "refusing to install into $dir: it is not owned by root (uid $owner)"
    (( (8#$mode & 8#022) == 0 )) \
      || emit_error "refusing to install into $dir: it is group- or world-writable"
  fi

  # The SOURCE is the plugin's own copy, which the user owns — that is expected:
  # it is the file being installed, and root reads it once from a visible
  # terminal. It is never the path pkexec executes.
  src="$(tun_helper_source_path)" \
    || emit_error "cannot locate bin/omarchy-v2ray-tun next to this script"
  [[ -f $src ]] || emit_error "the TUN helper source is missing: $src"
  [[ -x $src ]] || emit_error "the TUN helper source is not executable: $src"

  # ONE pkexec, so the user sees one password prompt and one auditable line:
  # `install -d` forces the parent to root:root 0755 (repairing a missing tree),
  # then `install -Dm755` writes the helper. Both paths are %q-quoted for the
  # terminal's shell; the plugin directory is user-controlled and may contain
  # spaces.
  install_cmd="pkexec /bin/sh -c $(printf '%q' \
    "install -d -o root -g root -m 0755 $(printf '%q' "$dir") && install -Dm755 $(printf '%q' "$src") $(printf '%q' "$dest")")"

  local launcher="omarchy-launch-floating-terminal-with-presentation"
  if command -v "$launcher" >/dev/null 2>&1; then
    setsid "$launcher" "$install_cmd" >/dev/null 2>&1 &
  else
    setsid xdg-terminal-exec "$install_cmd" >/dev/null 2>&1 &
  fi
  jq -n --arg helper "$dest" --arg command "$install_cmd" \
    '{ok:true, launched:true, needsAuth:true, helper:$helper, command:$command}'
  exit 0
}

# -----------------------------------------------------------------------------
# Subcommand: reveal
# -----------------------------------------------------------------------------
cmd_reveal() {
  ensure_dirs
  setsid xdg-open "$CONFIG_DIR" >/dev/null 2>&1 &
  emit_ok '{"ok":true}'
}

# -----------------------------------------------------------------------------
# Dispatch
# -----------------------------------------------------------------------------
case "${1:-}" in
  status)         cmd_status ;;
  tun-status)     cmd_tun_status ;;
  tun-up)         shift; cmd_tun_up "${1:-}" ;;
  tun-down)       cmd_tun_down ;;
  tun-toggle)     shift; cmd_tun_toggle "${1:-}" ;;
  list)           cmd_list ;;
  import)         shift; cmd_import "$@" ;;
  remove)         shift; cmd_remove "$@" ;;
  start)          shift; cmd_start "$@" ;;
  stop)           cmd_stop ;;
  restart)        shift; cmd_restart "$@" ;;
  toggle)         shift; cmd_toggle "$@" ;;
  ping)           shift; cmd_ping "$@" ;;
  link)           shift; cmd_link "$@" ;;
  log)            shift; cmd_log "$@" ;;
  autostart)      shift; cmd_autostart "$@" ;;
  install-engine) cmd_install_engine ;;
  install-xray)   cmd_install_xray ;;
  install-tun)    cmd_install_tun ;;
  debug)          shift; cmd_debug "${1:-}" ;;
  reveal)         cmd_reveal ;;
  version)        echo "$VERSION" ;;
  ""|-h|--help)
    sed -n '/^# SUBCOMMANDS/,/^# EXIT CODES/p' "$0" | sed 's/^# \?//' | grep -v '^$'
    exit 0
    ;;
  *)
    emit_error "unknown subcommand: $1"
    ;;
esac
